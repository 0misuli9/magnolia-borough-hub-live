# Global daily chat request ceiling. Set real billing caps in the OpenAI dashboard too.
OPENAI_DAILY_CHAT_MAX=2000

# Staff authorization hardening. Leave MFA off until every staff user has enrolled TOTP.
STAFF_REQUIRE_MFA=false
STAFF_ALLOWED_ROLES=staff,admin,owner,clerk

# Optional. Public/system audit events use actor_id = null when this is unset.
AUDIT_SYSTEM_ACTOR_ID=
